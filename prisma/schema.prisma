generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "branch"]
}

/// Applied manually in PostgreSQL. Do not run Prisma migrate/db push for this schema.
enum SapModule {
  PR
  PO

  @@map("sap_module")
  @@schema("public")
}

enum UserType {
  Console
  Client

  @@map("user_type")
  @@schema("public")
}

enum SysLandscape {
  DEV
  QAS
  PRD

  @@map("sys_landscape")
  @@schema("public")
}

enum ErpType {
  ECC
  S4H

  @@map("erp_type")
  @@schema("public")
}

enum ErpProductType {
  On_Primes @map("On-Primes")
  Cloud

  @@map("erp_product_type")
  @@schema("public")
}

model Client {
  id         BigInt   @id @default(dbgenerated("nextval('client_seq')"))
  name       String   @db.VarChar(250)
  symbole    String   @unique @db.VarChar(5)
  shortname  String?  @db.VarChar(50)
  address1   String?  @db.VarChar(200)
  address2   String?  @db.VarChar(200)
  address3   String?  @db.VarChar(200)
  state      String?  @db.VarChar(100)
  city       String?  @db.VarChar(100)
  country    String?  @db.VarChar(100)
  pincode    String?  @db.VarChar(20)
  contact    String?  @db.VarChar(100)
  mobile     String?  @db.VarChar(100)
  phone      String?  @db.VarChar(100)
  email      String?  @db.VarChar(100)
  website    String?  @db.VarChar(100)
  gstin      String?  @db.VarChar(50)
  permission Json?
  logoname   String?  @db.VarChar(200)
  logoimage  Bytes?   @db.ByteA
  status     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sapSystems SapSystem[]
  users      User[]

  @@map("client")
  @@schema("public")
}

model User {
  id         BigInt   @id @default(dbgenerated("nextval('user_seq')"))
  name       String   @db.VarChar(150)
  userType   UserType @default(Client) @map("usertype")
  clientId   BigInt?  @map("clientid")
  isAdmin    Boolean  @default(false) @map("isadmin")
  shortname  String?  @db.VarChar(20)
  loginUser  String   @unique @map("login_user") @db.VarChar(60)
  loginEmail String   @unique @map("login_email") @db.VarChar(150)
  password   String?  @db.VarChar(500)
  phone      String?  @db.VarChar(50)
  mobile     String?  @db.VarChar(50)
  role       String?  @db.VarChar(100)
  permission Json?
  status     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  client        Client?            @relation(fields: [clientId], references: [id])
  clientSystems UserClientSystem[]

  @@map("users")
  @@schema("public")
}

model SapSystem {
  id          String         @id @db.VarChar(50)
  clientId    BigInt         @map("clientid")
  landscape   SysLandscape   @default(DEV)
  erp         ErpType        @default(S4H)
  productType ErpProductType @default(On_Primes) @map("producttype")
  baseUrl     String         @map("baseurl") @db.VarChar(500)
  sapClientId Int            @map("sapclientid")
  port        Int
  status      Boolean        @default(false)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  client     Client             @relation(fields: [clientId], references: [id])
  userAccess UserClientSystem[]

  @@unique([clientId, landscape, erp, productType], map: "UQ_clientsystem")
  @@map("sapsystem")
  @@schema("public")
}

model UserClientSystem {
  userId      BigInt   @map("userid")
  sapSystemId String   @map("sapsystemid") @db.VarChar(50)
  sapUser     String   @map("sapuser") @db.VarChar(100)
  sapPassword String?  @map("sappassword") @db.VarChar(500)
  status      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id])
  sapSystem SapSystem @relation(fields: [sapSystemId], references: [id])

  @@id([userId, sapSystemId], map: "pk_user_client_system")
  @@map("user_client_system")
  @@schema("public")
}

model ModuleLabel {
  moduleId  SapModule @map("moduleid")
  sapSection String   @map("sapsection") @db.VarChar(250)
  sapName    String   @map("sapname") @db.VarChar(250)
  labelName  String?  @map("lablename") @db.VarChar(250)

  @@id([moduleId, sapSection, sapName], map: "pk_module_label")
  @@map("module_label")
  @@schema("public")
}

model Country {
  id             String    @id @db.VarChar(5)
  name           String?   @db.VarChar(100)
  shortname      String?   @db.VarChar(100)
  telephoneCode  String?   @map("telephonecode") @db.VarChar(200)
  seqNo          Int?      @map("seqno")
  lastUpdateBy   String?   @map("lastupdateby") @db.VarChar(700)
  lastUpdateDate DateTime? @map("lastupdatedate") @db.Timestamp(6)

  states State[]

  @@map("country")
  @@schema("public")
}

model State {
  countryId      String    @map("countryid") @db.VarChar(5)
  stateCode      String    @map("statecode") @db.VarChar(5)
  stateName      String    @map("statename") @db.VarChar(150)
  stateShortName String?   @map("stateshortname") @db.VarChar(10)
  lastUpdateBy   String?   @map("lastupdateby") @db.VarChar(700)
  lastUpdateDate DateTime? @map("lastupdatedate") @db.Timestamp(6)

  country Country @relation(fields: [countryId], references: [id])
  cities  City[]

  @@id([countryId, stateCode], map: "pk_state")
  @@map("state")
  @@schema("public")
}

model City {
  countryId      String    @map("countryid") @db.VarChar(5)
  stateCode      String    @map("statecode") @db.VarChar(5)
  cityCode       String    @map("citycode") @db.VarChar(15)
  cityName       String    @map("cityname") @db.VarChar(150)
  cityShortName  String?   @map("cityshortname") @db.VarChar(150)
  lastUpdateBy   String?   @map("lastupdateby") @db.VarChar(700)
  lastUpdateDate DateTime? @map("lastupdatedate") @db.Timestamp(6)

  state State @relation(fields: [countryId, stateCode], references: [countryId, stateCode])

  @@id([countryId, stateCode, cityCode], map: "pk_city")
  @@map("city")
  @@schema("public")
}

/// WBS 2.3 stub so shipping_point.division_id can FK. Full Division master is not this story.
/// Applied in schema "branch" via sql/branch_shipping_point.sql. Do not Prisma migrate.
model Division {
  id        String    @id @default(uuid())
  code      String
  name      String
  status    String    @default("PUBLISHED")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  shippingPoints ShippingPoint[]

  @@map("division")
  @@schema("branch")
}

/// WBS 2.5 Shipping Point. Table is branch.shipping_point, not public.
model ShippingPoint {
  id               String    @id @default(uuid())
  code             String
  name             String
  divisionId       String    @map("division_id")
  type             String
  address          String
  latitude         Decimal   @db.Decimal(9, 6)
  longitude        Decimal   @db.Decimal(9, 6)
  geofenceRadiusM  Int?      @map("geofence_radius_m")
  openingHours     String?   @map("opening_hours")
  loadingBays      Int?      @map("loading_bays")
  loadingRateLpm   Decimal?  @map("loading_rate_lpm") @db.Decimal(12, 3)
  midShiftReload   Boolean?  @map("mid_shift_reload")
  productsStocked  String[]  @default([]) @map("products_stocked")
  leadDispatcher   String?   @map("lead_dispatcher")
  phone            String?
  hazmatClass      String?   @map("hazmat_class")
  permitNo         String?   @map("permit_no")
  permitExpiry     DateTime? @map("permit_expiry") @db.Date
  erpRef           String?   @map("erp_ref")
  validFrom        DateTime  @map("valid_from") @db.Date
  validTo          DateTime? @map("valid_to") @db.Date
  reason           String
  changeNote       String?   @map("change_note")
  status           String
  versionNo        Int       @default(1) @map("version_no")
  externalId       String?   @map("external_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?   @map("created_by")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?   @map("updated_by")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  division Division                 @relation(fields: [divisionId], references: [id])
  versions ShippingPointVersion[]
  audits   ShippingPointAudit[]

  @@map("shipping_point")
  @@schema("branch")
}

model ShippingPointVersion {
  id              String   @id @default(uuid())
  shippingPointId String   @map("shipping_point_id")
  versionNo       Int      @map("version_no")
  snapshot        Json
  recordedAt      DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  recordedBy      String?  @map("recorded_by")

  shippingPoint ShippingPoint @relation(fields: [shippingPointId], references: [id])

  @@unique([shippingPointId, versionNo], map: "shipping_point_version_udx")
  @@map("shipping_point_version")
  @@schema("branch")
}

model ShippingPointAudit {
  id              String   @id @default(uuid())
  shippingPointId String   @map("shipping_point_id")
  action          String
  actor           String?
  note            String?
  payload         Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shippingPoint ShippingPoint @relation(fields: [shippingPointId], references: [id])

  @@map("shipping_point_audit")
  @@schema("branch")
}

/// WBS 2.7 Vendor / Supplier (SAP sync). Table is branch.vendor, not public.
/// Applied via sql/branch_vendor.sql. Do not Prisma migrate.
model Vendor {
  id         String    @id @default(uuid())
  code       String
  name       String
  type       String
  active     Boolean   @default(true)
  validFrom  DateTime  @map("valid_from") @db.Date
  validTo    DateTime? @map("valid_to") @db.Date
  reason     String
  changeNote String?   @map("change_note")
  status     String
  versionNo  Int       @default(1) @map("version_no")
  externalId String?   @map("external_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?   @map("updated_by")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  versions VendorVersion[]
  audits   VendorAudit[]

  @@map("vendor")
  @@schema("branch")
}

model VendorVersion {
  id         String   @id @default(uuid())
  vendorId   String   @map("vendor_id")
  versionNo  Int      @map("version_no")
  snapshot   Json
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  recordedBy String?  @map("recorded_by")

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, versionNo], map: "vendor_version_udx")
  @@map("vendor_version")
  @@schema("branch")
}

model VendorAudit {
  id        String   @id @default(uuid())
  vendorId  String   @map("vendor_id")
  action    String
  actor     String?
  note      String?
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@map("vendor_audit")
  @@schema("branch")
}
