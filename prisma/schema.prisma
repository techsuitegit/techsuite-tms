  versions HaulierVersion[]
  audits   HaulierAudit[]

  @@map("haulier")
  @@schema("branch")
}

model HaulierVersion {
  id         String   @id @default(uuid())
  haulierId  String   @map("haulier_id")
  versionNo  Int      @map("version_no")
  snapshot   Json
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  recordedBy String?  @map("recorded_by")

  haulier Haulier @relation(fields: [haulierId], references: [id])

  @@unique([haulierId, versionNo], map: "haulier_version_udx")
  @@map("haulier_version")
  @@schema("branch")
}

model HaulierAudit {
  id         String   @id @default(uuid())
  haulierId  String   @map("haulier_id")
  action     String
  actor      String?
  note       String?
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  haulier Haulier @relation(fields: [haulierId], references: [id])

  @@map("haulier_audit")
  @@schema("branch")
}
