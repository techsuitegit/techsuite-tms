              "raw": "{{baseUrl}}/api/v1/mdm/materials?q=HSD&status=PUBLISHED&page=1&pageSize=20&sort=code",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "mdm", "materials"],
              "query": [
                { "key": "q", "value": "HSD", "description": "Search code or name" },
                { "key": "status", "value": "PUBLISHED", "description": "DRAFT | PENDING | PUBLISHED | REJECTED | ARCHIVED" },
                { "key": "page", "value": "1" },
