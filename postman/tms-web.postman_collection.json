{
  "info": {
    "_postman_id": "8c3d1a7e-4b92-4f16-9e21-tms-web",
    "name": "tms-web",
    "description": "V1 POST APIs for tms-web.\n\n1. Set `baseUrl` (default `http://localhost:3000/api`).\n2. Run **auth / login** — the test script stores `token`.\n3. Remaining folders send `Authorization: Bearer {{token}}`.\n\nPublic (no JWT): `auth/login`, `user/registration`.\nAll other requests require JWT.\n\nSAP BFF (Client JWT): `po/details`, `po/approve`, `pr/details`, `pr/approve`. Login also stores `sapSystemId` from the JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "login", "value": "console.admin@local.test" },
    { "key": "password", "value": "Admin@123" },
    { "key": "clientId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "sapSystemId", "value": "" }
  ],
  "item": [
    {
      "name": "auth",
      "item": [
        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const token = json?.data?.token;",
                  "  if (token) {",
                  "    pm.collectionVariables.set('token', token);",
                  "    const user = json.data.user || {};",
                  "    if (!user.id && token) {",
                  "      try {",
                  "        const payload = JSON.parse(atob(token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));",
                  "        Object.assign(user, payload.user || {});",
                  "      } catch (e) {}",
                  "    }",
                  "    if (user.id) pm.collectionVariables.set('userId', String(user.id));",
                  "    if (user.clientid) pm.collectionVariables.set('clientId', String(user.clientid));",
                  "    if (user.sapsystems && user.sapsystems[0] && user.sapsystems[0].id) {",
                  "      pm.collectionVariables.set('sapSystemId', String(user.sapsystems[0].id));",
                  "    }",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/v1/auth/login",
            "description": "Public. Returns `{ token, usertype }` only. Decode the JWT to read `user` (Client includes encrypted `sapsystems`)."
          }
        }
      ]
    },
