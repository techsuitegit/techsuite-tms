            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Submit rate sample\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/hauliers/{{rateHaulierId}}/submit",
            "description": "DRAFT → PENDING."
          }
        },
        {
          "name": "16 POST approve rate sample",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Rate approved\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/hauliers/{{rateHaulierId}}/approve",
            "description": "PENDING → PUBLISHED."
          }
        },
        {
          "name": "17 GET rate sample — refresh version",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().versionNo) {",
                  "  pm.collectionVariables.set('rateVersionNo', String(pm.response.json().versionNo));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/mdm/hauliers/{{rateHaulierId}}",
            "description": "Saves {{rateVersionNo}}. After create, submit, and approve it is 3."
          }
        },
        {
          "name": "18 PATCH published rate — returns PENDING",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"H-COL-RATE\",\n  \"name\": \"Rate Change Haul\",\n  \"vehicleTypes\": [\"TANK_TRAILER\"],\n  \"hazmatCertified\": false,\n  \"rateBasis\": \"PER_TRIP\",\n  \"rate\": 3.10,\n  \"contractStart\": \"2026-01-01\",\n  \"contractEnd\": \"2027-12-31\",\n  \"validFrom\": \"2026-04-01\",\n  \"reason\": \"Commercial change\",\n  \"changeNote\": \"Rate 2.85 to 3.10\",\n  \"versionNo\": {{rateVersionNo}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/hauliers/{{rateHaulierId}}",
            "description": "200 { status: PENDING }. A published rate change must be approved again. Run request 17 first."
          }
        }
      ]
    },
    {
      "name": "3. Expiring and validation",
      "item": [
        {
          "name": "19 POST contract ending inside 60 days",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"H-COL-EXP\",\n  \"name\": \"Short Contract Haul\",\n  \"vehicleTypes\": [\"CYLINDER_TRUCK\"],\n  \"hazmatCertified\": true,\n  \"rateBasis\": \"PER_HOUR\",\n  \"rate\": 95,\n  \"contractStart\": \"2026-01-01\",\n  \"contractEnd\": \"2026-11-01\",\n  \"validFrom\": \"2026-04-01\",\n  \"reason\": \"New record\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/hauliers",
            "description": "201 DRAFT. contractEnd 2026-11-01 is before today plus 60 days, so the list marks it expiring. Status stays DRAFT."
          }
        },
        {
          "name": "20 GET list — expiring",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/mdm/hauliers?q=H-COL-EXP",
            "description": "200. The H-COL-EXP item has expiring true. Run request 19 first."
          }
        },
        {
          "name": "21 POST contractEnd before start (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"H-COL-BADDATE\",\n  \"name\": \"Bad dates\",\n  \"vehicleTypes\": [\"BOBTAIL_LPG\"],\n  \"hazmatCertified\": false,\n  \"rateBasis\": \"PER_KM\",\n  \"rate\": 2.85,\n  \"contractStart\": \"2026-06-01\",\n  \"contractEnd\": \"2026-01-01\",\n  \"validFrom\": \"2026-04-01\",\n  \"reason\": \"New record\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/hauliers",
            "description": "400 { code: VALIDATION, field: contractEnd }."
          }
        },
        {
          "name": "22 GET list — no token (expect 401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/mdm/hauliers",
            "description": "401 when Authorization is missing."
          }
        },
        {
          "name": "23 POST invalid vehicle type (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"H-COL-BADTYPE\",\n  \"name\": \"Bad type\",\n  \"vehicleTypes\": [\"TRUCK\"],\n  \"hazmatCertified\": false,\n  \"rateBasis\": \"PER_KM\",\n  \"rate\": 2.85,\n  \"contractStart\": \"2026-01-01\",\n  \"contractEnd\": \"2027-12-31\",\n  \"validFrom\": \"2026-04-01\",\n  \"reason\": \"New record\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/hauliers",
            "description": "400 { code: VALIDATION, field: vehicleTypes }. Values must match the Vehicle class enum."
          }
        },
        {
          "name": "24 POST rate 0 (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"H-COL-NORATE\",\n  \"name\": \"Zero rate\",\n  \"vehicleTypes\": [\"BOBTAIL_REFINED\"],\n  \"hazmatCertified\": false,\n  \"rateBasis\": \"PER_LITRE\",\n  \"rate\": 0,\n  \"contractStart\": \"2026-01-01\",\n  \"contractEnd\": \"2027-12-31\",\n  \"validFrom\": \"2026-04-01\",\n  \"reason\": \"New record\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/hauliers",
            "description": "400 { code: VALIDATION, field: rate }. rate must be greater than 0."
          }
        }
      ]
    },
    {
      "name": "4. Reject path",
      "item": [
        {
          "name": "25 POST create — reject sample",
          "event": [
            {
              "listen": "test",
