              "raw": "{\n  \"code\": \"H-COL-REJ\",\n  \"name\": \"Reject Haul\",\n  \"vehicleTypes\": [\"BOBTAIL_REFINED\"],\n  \"hazmatCertified\": false,\n  \"rateBasis\": \"PER_TONNE\",\n  \"rate\": 40,\n  \"contractStart\": \"2026-01-01\",\n  \"contractEnd\": \"2027-06-30\",\n  \"validFrom\": \"2026-04-01\",\n  \"reason\": \"New record\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/hauliers",
            "description": "201 DRAFT. Saves {{rejectHaulierId}}."
          }
        },
        {
          "name": "26 POST submit reject sample",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Submit for reject test\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/hauliers/{{rejectHaulierId}}/submit",
            "description": "DRAFT → PENDING."
          }
        },
        {
          "name": "27 POST reject — missing note (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/hauliers/{{rejectHaulierId}}/reject",
            "description": "400 { code: VALIDATION, field: note }. The row stays PENDING."
          }
        },
        {
          "name": "28 POST reject",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Insurance certificate is missing\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/hauliers/{{rejectHaulierId}}/reject",
            "description": "PENDING → REJECTED. 200 { status: REJECTED }."
          }
        },
        {
          "name": "29 PATCH rejected — back to DRAFT",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"H-COL-REJ\",\n  \"name\": \"Reject Haul\",\n  \"vehicleTypes\": [\"BOBTAIL_REFINED\"],\n  \"hazmatCertified\": false,\n  \"rateBasis\": \"PER_TONNE\",\n  \"rate\": 40,\n  \"contractStart\": \"2026-01-01\",\n  \"contractEnd\": \"2027-06-30\",\n  \"validFrom\": \"2026-04-01\",\n  \"reason\": \"Correction\",\n  \"changeNote\": \"Insurance attached\",\n  \"versionNo\": 3\n}",
