    {
      "name": "4. Import / export / archive",
      "item": [
        {
          "name": "22 GET export GeoJSON FeatureCollection",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/mdm/dg-restriction-zones/export",
            "description": "FeatureCollection; properties carry non-geometry fields including sourceKind / sourceRef."
          }
        },
        {
          "name": "23 POST import FeatureCollection",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"FeatureCollection\",\n  \"features\": [\n    {\n      \"type\": \"Feature\",\n      \"geometry\": {\n        \"type\": \"Polygon\",\n        \"coordinates\": [[\n          [80.2700, 13.0100],\n          [80.2750, 13.0100],\n          [80.2750, 13.0050],\n          [80.2700, 13.0050],\n          [80.2700, 13.0100]\n        ]]\n      },\n      \"properties\": {\n        \"code\": \"Z-IMP-PM\",\n        \"name\": \"Import feature — illustrative\",\n        \"kindCode\": \"PROHIBIT\",\n        \"dgClasses\": [],\n        \"geomSource\": \"SKETCHED\",\n        \"windowFromMin\": 0,\n        \"windowToMin\": 1440,\n        \"params\": {},\n        \"sourceKind\": \"ILLUSTRATIVE\",\n        \"sourceRef\": \"Illustrative import feature\",\n        \"reviewDue\": \"2026-12-31\",\n        \"validFrom\": \"2026-04-01\",\n        \"reason\": \"New record\"\n      }\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/dg-restriction-zones/import",
            "description": "200 { accepted[], rejected[] }. Row-level fail."
          }
        },
        {
          "name": "24 POST archive published zone",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Notification withdrawn\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/dg-restriction-zones/{{publishableZoneId}}/archive",
            "description": "Only when status is PUBLISHED. Drops from /feed immediately."
          }
        },
        {
          "name": "25 POST reject (PENDING only)",
