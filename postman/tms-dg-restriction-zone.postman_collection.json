            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"Z-BAD-WIN\",\n  \"name\": \"Bad window\",\n  \"kindCode\": \"TIME\",\n  \"dgClasses\": [],\n  \"geometry\": {\n    \"type\": \"Polygon\",\n    \"coordinates\": [[\n      [80.2550, 13.0065],\n      [80.2605, 13.0065],\n      [80.2605, 13.0020],\n      [80.2550, 13.0020],\n      [80.2550, 13.0065]\n    ]]\n  },\n  \"geomSource\": \"SKETCHED\",\n  \"windowFromMin\": 420,\n  \"windowToMin\": 420,\n  \"params\": {},\n  \"sourceKind\": \"ILLUSTRATIVE\",\n  \"sourceRef\": \"Illustrative empty window\",\n  \"reviewDue\": \"2026-12-31\",\n  \"validFrom\": \"2026-04-01\",\n  \"reason\": \"New record\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/dg-restriction-zones"
          }
        },
        {
          "name": "17 POST midnight wrap window (1320 → 300) — OK",
          "request": {
