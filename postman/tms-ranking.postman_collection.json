            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ops/ranking/pool",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ops", "ranking", "pool"],
              "query": [
                { "key": "divisionId", "value": "{{divisionId}}", "disabled": true },
                { "key": "dueBefore", "value": "2026-12-31", "disabled": true },
                { "key": "runId", "value": "{{runId}}", "disabled": true },
                { "key": "asOf", "value": "2026-11-16", "disabled": true }
              ]
            },
            "description": "Ranked feed for downstream modules. Carries qualified qty, risk band, rank source. Optional `runId` / `asOf`."
          }
        },
        {
          "name": "25 GET order score history",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('score history', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().scores).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/ops/ranking/orders/{{orderId}}/scores",
            "description": "One order across runs — append-only ledger rows."
          }
        }
      ]
    },
    {
      "name": "3. Planner reorder",
      "item": [
        {
          "name": "30 POST reorder — move to position 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('reorder creates superseding run', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.run).to.exist;",
                  "  pm.expect(json.run.trigger).to.eql('API');",
                  "  pm.expect(json.run.supersedesRunId).to.be.ok;",
                  "  pm.expect(json.override).to.exist;",
                  "  pm.expect(json.override.status).to.eql('ACTIVE');",
                  "  const moved = (json.items || []).find((i) => i.orderId === pm.collectionVariables.get('reorderOrderId'));",
                  "  if (moved) {",
                  "    pm.expect(moved.rankPosition).to.eql(1);",
                  "    pm.expect(moved.rankSource).to.eql('PLANNER');",
                  "  }",
                  "});",
                  "const json = pm.response.json() || {};",
                  "if (json.run && json.run.id) {",
                  "  pm.collectionVariables.set('supersededRunId', json.run.supersedesRunId || pm.collectionVariables.get('runId'));",
                  "  pm.collectionVariables.set('runId', json.run.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{reorderOrderId}}\",\n  \"toPosition\": 1,\n  \"reasonCode\": \"PLANNER_PRIORITY\",\n  \"grounds\": \"Customer critical SLA window\",\n  \"reference\": \"TCK-1001\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/ranking/runs/{{runId}}/reorder",
            "description": "Planner override. Writes a **new** run (trigger=API) that supersedes the current one; score ledger stays append-only.\n\nRules:\n- `grounds` ≥ 8 chars\n- `reference` ≥ 3 chars\n- `reasonCode` required\n- 409 `RUN_NOT_CURRENT` if a newer run already exists\n\nMoved row: `rankSource=PLANNER`. Later engine runs carry the pin forward (BE-09)."
          }
        },
        {
          "name": "31 POST reorder — grounds too short (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('grounds validation', function () {",
                  "  pm.response.to.have.status(400);",
                  "  const json = pm.response.json();",
                  "  const code = json.code || json.error || '';",
                  "  pm.expect(String(code)).to.match(/GROUNDS|VALIDATION|grounds/i);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{reorderOrderId}}\",\n  \"toPosition\": 1,\n  \"reasonCode\": \"PLANNER_PRIORITY\",\n  \"grounds\": \"short\",\n  \"reference\": \"TCK-1001\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/ranking/runs/{{runId}}/reorder",
            "description": "Expect 400 `GROUNDS_TOO_SHORT`."
          }
        },
        {
          "name": "32 POST reorder — superseded run (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sid = pm.collectionVariables.get('supersededRunId');",
                  "if (!sid) {",
                  "  console.warn('skip: no supersededRunId — run 30 first');",
                  "  return;",
                  "}",
                  "pm.test('RUN_NOT_CURRENT', function () {",
                  "  pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{reorderOrderId}}\",\n  \"toPosition\": 2,\n  \"reasonCode\": \"PLANNER_PRIORITY\",\n  \"grounds\": \"Trying to reorder an old run\",\n  \"reference\": \"TCK-1002\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/ranking/runs/{{supersededRunId}}/reorder",
            "description": "After 30, reordering the **old** run id must 409 `RUN_NOT_CURRENT`."
          }
        },
        {
          "name": "33 GET queue after reorder",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/ops/ranking/queue",
            "description": "Current queue should show planner pin at position 1 with `rankSource=PLANNER`."
          }
        }
      ]
    },
    {
      "name": "4. Simulate",
      "item": [
        {
          "name": "40 POST simulate weight set",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('simulate writes nothing', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.writesNothing).to.eql(true);",
                  "  pm.expect(json.current).to.be.an('array');",
                  "  pm.expect(json.proposed).to.be.an('array');",
                  "  pm.expect(json.moved).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"divisionId\": null,\n  \"dueBefore\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/ranking/weight-sets/{{weightSetId}}/simulate",
            "description": "Side-by-side current vs proposed ordering for a weight set. **Does not write** score rows or runs."
          }
        }
      ]
    }
  ]
}
