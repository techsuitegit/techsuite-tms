        },
        {
          "name": "11 GET weight-set by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('weight-set has five components', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.components).to.be.an('array').with.lengthOf(5);",
                  "  const risk = json.components.find((c) => c.componentCode === 'RUN_OUT_RISK');",
                  "  pm.expect(risk).to.exist;",
                  "  pm.expect(risk.zeroAtDays).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/ops/ranking/weight-sets/{{weightSetId}}",
            "description": "Full set + components. `zeroAtDays` on RUN_OUT_RISK ≈ 5.7 with seed 40/7."
          }
        },
        {
          "name": "12 GET customer-classes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('A1–A4 placeholders', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const items = pm.response.json().items || [];",
                  "  pm.expect(items.length).to.eql(4);",
                  "  items.forEach((r) => {",
                  "    pm.expect(r.definitionSource).to.eql('PLACEHOLDER');",
                  "    pm.expect(r.scoreContribution).to.eql(null);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/ops/ranking/customer-classes",
            "description": "I-001 open: A1–A4 PLACEHOLDER, `scoreContribution` null → segment fallback at score time."
          }
        }
      ]
    },
    {
      "name": "2. Rank now",
      "item": [
        {
          "name": "20 POST run — ADDITIVE (default)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ranking run completed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.run).to.exist;",
                  "  pm.expect(json.run.status).to.eql('COMPLETED');",
                  "  pm.expect(json.run.orderingStrategy).to.eql('ADDITIVE');",
                  "  pm.expect(json.items).to.be.an('array');",
                  "});",
                  "const json = pm.response.json() || {};",
                  "if (json.run && json.run.id) pm.collectionVariables.set('runId', json.run.id);",
                  "const items = json.items || [];",
                  "if (items[0] && items[0].orderId) {",
                  "  pm.collectionVariables.set('orderId', items[0].orderId);",
                  "}",
                  "if (items.length > 1 && items[items.length - 1].orderId) {",
                  "  pm.collectionVariables.set('reorderOrderId', items[items.length - 1].orderId);",
                  "} else if (items[0] && items[0].orderId) {",
                  "  pm.collectionVariables.set('reorderOrderId', items[0].orderId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trigger\": \"ON_DEMAND\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/ranking/runs",
            "description": "Scores QUALIFIED pool, writes run + append-only score rows in one transaction.\n\nOptional body:\n```json\n{\n  \"trigger\": \"ON_DEMAND\",\n  \"divisionId\": \"...\",\n  \"dueBefore\": \"2026-12-31\",\n  \"orderingStrategy\": \"ADDITIVE\"\n}\n```\n\n409 `RUN_IN_PROGRESS` · 409 `NO_PUBLISHED_WEIGHT_SET`\n\nSaves `runId`, `orderId` (rank #1), `reorderOrderId` (last / same)."
          }
        },
        {
          "name": "20b POST run — BAND_THEN_SCORE (optional)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('band strategy recorded on run', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.run.orderingStrategy).to.eql('BAND_THEN_SCORE');",
                  "});",
                  "const json = pm.response.json() || {};",
                  "if (json.run && json.run.id) {",
                  "  pm.collectionVariables.set('supersededRunId', pm.collectionVariables.get('runId') || '');",
                  "  pm.collectionVariables.set('runId', json.run.id);",
                  "}",
                  "const items = json.items || [];",
                  "if (items[0] && items[0].orderId) pm.collectionVariables.set('orderId', items[0].orderId);",
                  "if (items.length > 1) pm.collectionVariables.set('reorderOrderId', items[items.length - 1].orderId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trigger\": \"ON_DEMAND\",\n  \"orderingStrategy\": \"BAND_THEN_SCORE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/ranking/runs",
            "description": "Same pool, lexicographic band-first sort. Critical low-value can outrank comfortable high-value. Skip if you want to keep the ADDITIVE run current for reorder tests."
          }
        },
        {
          "name": "21 GET queue (current ranked)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
