            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ops/ranking/runs?page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ops", "ranking", "runs"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "23 GET run by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('run detail with items', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.run.id).to.eql(pm.collectionVariables.get('runId'));",
                  "  pm.expect(json.items).to.be.an('array');",
                  "  if (json.items.length) {",
                  "    const row = json.items[0];",
                  "    pm.expect(row).to.have.property('totalScore');",
                  "    pm.expect(row).to.have.property('components');",
                  "    pm.expect(row.components).to.include.keys('risk','value','size','class','window');",
                  "    pm.expect(row).to.have.property('classSource');",
                  "    pm.expect(row).to.have.property('rankSource');",
                  "  }",
