{
  "info": {
    "_postman_id": "c8f3d02b-5e29-4a1f-8d42-tms-vendor",
    "name": "TMS — Vendor (WBS 2.7)",
    "description": "Vendor / Supplier SAP sync APIs on the Node process (port 3001).\n\n1. Start: `npm run api`\n2. Schema + seeds: `npm run api:sql` (creates branch.vendor and HPCL / IOCL / BPCL / Otodata).\n3. Set collection variables `login` and `password`.\n4. Run **Login** first. The test script saves `token`.\n5. No trailing slash on URLs.\n\nTMS create/amend is forbidden (POST/PATCH 405). The only write is sap-upsert.\ntype: SUPPLIER | CARRIER | DEVICE\nreason: Correction | New record | Regulatory update | Commercial change\nenviroment is spelled that way on purpose.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "token", "value": "" },
    { "key": "login", "value": "your.email@company.com" },
    { "key": "password", "value": "" },
    { "key": "producttype", "value": "TMS" },
    { "key": "enviroment", "value": "DEV" },
    { "key": "vendorId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Login",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "No token. Expect { ok: true, name: tms-api }."
          }
        },
        {
          "name": "Login — get accessToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const token = json.accessToken || json.access_token || json.token;",
                  "  if (token) {",
                  "    pm.collectionVariables.set('token', token);",
                  "    console.log('token saved');",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"producttype\": \"{{producttype}}\",\n  \"enviroment\": \"{{enviroment}}\",\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/jwt/login",
            "description": "Public. Saves accessToken to {{token}}."
          }
        }
      ]
    },
    {
      "name": "1. SAP upsert (only write)",
      "item": [
        {
          "name": "01 SAP upsert — required fields (HPCL SUPPLIER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) pm.collectionVariables.set('vendorId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalId\": \"V-HPCL\",\n  \"code\": \"300012\",\n  \"name\": \"HPCL\",\n  \"type\": \"SUPPLIER\",\n  \"active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/vendors/sap-upsert",
            "description": "Required body. Idempotent on externalId. AUTO publishes.\n200 { id, externalId, status: PUBLISHED }.\nSaves id to {{vendorId}}."
          }
        },
        {
          "name": "02 SAP upsert — full optional fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.id) pm.collectionVariables.set('vendorId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalId\": \"V-HPCL\",\n  \"code\": \"300012\",\n  \"name\": \"HPCL\",\n  \"type\": \"SUPPLIER\",\n  \"active\": true,\n  \"validFrom\": \"2026-04-01\",\n  \"validTo\": null,\n  \"reason\": \"Correction\",\n  \"changeNote\": \"SAP stub sync\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/vendors/sap-upsert",
            "description": "Same externalId updates the existing row. Unknown JSON keys return 400."
          }
        },
        {
          "name": "03 SAP upsert — DEVICE (Otodata)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalId\": \"V-OTODATA\",\n  \"code\": \"D-OTO-01\",\n  \"name\": \"Otodata\",\n  \"type\": \"DEVICE\",\n  \"active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/vendors/sap-upsert",
            "description": "Device vendor. Hidden from lookups?type=SUPPLIER."
          }
        },
        {
          "name": "04 SAP upsert — missing SAP key (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"300012\",\n  \"name\": \"HPCL\",\n  \"type\": \"SUPPLIER\",\n  \"active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/vendors/sap-upsert",
            "description": "Expect 400 { code: VALIDATION, message: missing SAP key, field: externalId }."
          }
        }
      ]
    },
    {
      "name": "2. Read",
      "item": [
        {
          "name": "05 List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/mdm/vendors?page=1&pageSize=20&sort=code",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "mdm", "vendors"],
              "query": [
                { "key": "q", "value": "", "description": "Search code or name", "disabled": true },
                { "key": "status", "value": "PUBLISHED", "description": "DRAFT | PENDING | PUBLISHED | REJECTED | ARCHIVED", "disabled": true },
                { "key": "type", "value": "SUPPLIER", "description": "SUPPLIER | CARRIER | DEVICE", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" },
                { "key": "sort", "value": "code", "description": "code | name | status | validFrom | updatedAt" }
              ]
            },
            "description": "No body. 200 { items, total, page }."
          }
        },
        {
          "name": "06 Get one",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/mdm/vendors/{{vendorId}}",
            "description": "No body. 200 current row. 404 if id is missing."
          }
        },
        {
          "name": "07 Lookups — SUPPLIER (hides DEVICE)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/mdm/lookups/vendors?type=SUPPLIER",
            "description": "No body. Published + active only.\n200 [{ id, code, name }]. Otodata DEVICE is hidden."
          }
        },
        {
          "name": "08 Lookups — all published active",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/mdm/lookups/vendors",
            "description": "No type filter. Includes DEVICE rows."
          }
        },
        {
          "name": "09 Versions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/mdm/vendors/{{vendorId}}/versions",
            "description": "No body. 200 { versions: [{ versionNo, snapshot, recordedAt, recordedBy }] }."
          }
        },
        {
          "name": "10 Audit",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/mdm/vendors/{{vendorId}}/audit",
            "description": "No body. 200 { events: [{ action, actor, note, payload, createdAt }] }."
          }
        }
      ]
    },
    {
      "name": "3. Forbidden UI writes (405)",
      "item": [
        {
          "name": "11 POST create (expect 405)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"300099\",\n  \"name\": \"Should Fail\",\n  \"type\": \"SUPPLIER\",\n  \"active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/vendors",
            "description": "TMS create is forbidden. Expect 405 { code: METHOD_NOT_ALLOWED, message: Method not allowed }."
          }
        },
        {
          "name": "12 PATCH amend (expect 405)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Should Fail\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/mdm/vendors/{{vendorId}}",
            "description": "TMS amend is forbidden. Expect 405 { code: METHOD_NOT_ALLOWED, message: Method not allowed }."
          }
        }
      ]
    }
  ]
}
