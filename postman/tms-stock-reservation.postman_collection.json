              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"routeId\": \"{{routeId}}-DRAFT\",\n  \"routeStatus\": \"DRAFT\",\n  \"planId\": \"{{planId}}\",\n  \"planKind\": \"LIVE\",\n  \"tripNo\": 1,\n  \"plannedDeparture\": \"{{reserveDate}}T05:30:00+05:30\",\n  \"reserveDate\": \"{{reserveDate}}\",\n  \"orders\": [{ \"orderId\": \"{{orderId}}\" }]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/trips/{{tripId}}-DRAFT/reservations",
            "description": "A draft is a proposal. Nothing is written."
          }
        },
        {
          "name": "31 POST scenario (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('scenario reserves nothing', function () {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().code).to.eql('SCENARIO_PLAN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"routeId\": \"{{routeId}}-SCN\",\n  \"routeStatus\": \"CONFIRMED\",\n  \"planId\": \"{{planId}}-SCN\",\n  \"planKind\": \"SCENARIO\",\n  \"tripNo\": 1,\n  \"plannedDeparture\": \"{{reserveDate}}T05:30:00+05:30\",\n  \"reserveDate\": \"{{reserveDate}}\",\n  \"orders\": [{ \"orderId\": \"{{orderId}}\" }]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/trips/{{tripId}}-SCN/reservations",
            "description": "A scenario fork reserves nothing. No reservation row and no position change."
          }
        },
        {
          "name": "32 POST reserve confirmed trip",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('confirmed trip reserves or names why not', function () {",
                  "  pm.expect([200, 422]).to.include(pm.response.code);",
                  "  const body = pm.response.json();",
                  "  if (pm.response.code === 422) {",
                  "    pm.expect(body.code).to.eql('NO_RACKABLE_TERMINAL');",
                  "    return;",
                  "  }",
                  "  pm.expect(body.reservations).to.be.an('array');",
                  "  const row = body.reservations[0];",
                  "  pm.expect(row).to.be.an('object');",
                  "  pm.expect(['RESERVED', 'SHORT', 'UNVERIFIED']).to.include(row.commitmentOutcome);",
                  "  pm.collectionVariables.set('reservationId', row.id);",
                  "  pm.collectionVariables.set('versionNo', String(row.versionNo));",
                  "  pm.collectionVariables.set('qualifiedQty', String(row.qualifiedQty));",
                  "  pm.collectionVariables.set('reservedQtyUom', row.reservedQtyUom);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"routeId\": \"{{routeId}}\",\n  \"routeStatus\": \"CONFIRMED\",\n  \"planId\": \"{{planId}}\",\n  \"planKind\": \"LIVE\",\n  \"tripNo\": 1,\n  \"plannedDeparture\": \"{{reserveDate}}T05:30:00+05:30\",\n  \"reserveDate\": \"{{reserveDate}}\",\n  \"orders\": [\n    {\n      \"orderId\": \"{{orderId}}\",\n      \"shipToLatitude\": 13.05,\n      \"shipToLongitude\": 80.25\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/trips/{{tripId}}/reservations",
            "description": "Idempotent per key and order. Repeating it returns the existing live reservation. Saves `reservationId`, `versionNo`, `qualifiedQty`, `reservedQtyUom`. Packed or unqualified orders are skipped, not failed. 422 when no terminal racks the product."
          }
        },
        {
          "name": "33 GET queue",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('queue page', function () {",
