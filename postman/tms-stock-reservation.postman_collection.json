                  "  pm.expect(pm.response.json().rows).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Idempotency-Key", "value": "{{$guid}}" }],
            "url": "{{baseUrl}}/api/v1/ops/terminal-stock/rebuild",
            "description": "Truncates the projection and rebuilds it from current declarations and the reservation ledger."
          }
        }
      ]
    },
    {
      "name": "6. Release",
      "item": [
        {
          "name": "60 POST reserve second trip",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('second trip reserved', function () {",
