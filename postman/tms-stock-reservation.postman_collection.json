            "description": "Append-only, newest sequence last in this payload is highest `seq` first. `candidates` is the engine's working: distance, rack flag, and why a terminal was rejected."
          }
        },
        {
          "name": "36 GET export CSV",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('csv', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.text()).to.include('reservationNo');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/ops/reservations/export?tripId={{tripId}}"
          }
        }
      ]
    },
    {
      "name": "4. Amend, reassign, extend",
      "item": [
        {
          "name": "40 PATCH quantity",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('quantity follows qualified qty', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.reservedQty).to.eql(Number(pm.collectionVariables.get('qualifiedQty')));",
                  "  pm.collectionVariables.set('versionNo', String(body.versionNo));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservedQty\": {{qualifiedQty}},\n  \"reservedQtyUom\": \"{{reservedQtyUom}}\",\n  \"reason\": \"Qualified quantity amended after manual qualification.\",\n  \"versionNo\": {{versionNo}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/reservations/{{reservationId}}/quantity",
            "description": "The new quantity must equal the order's current qualified quantity. Anything else is 400 `QTY_NOT_QUALIFIED_QTY`. A stale `versionNo` is 409 `STALE_VERSION`."
          }
        },
        {
          "name": "41 POST reassign — grounds too short (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('grounds too short', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().code).to.eql('GROUNDS_TOO_SHORT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toTerminalId\": \"{{toTerminalId}}\",\n  \"reasonCode\": \"RSN_TERMINAL_OUTAGE\",\n  \"grounds\": \"short\",\n  \"reference\": \"TERM-OUT-01\",\n  \"versionNo\": {{versionNo}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/reservations/{{reservationId}}/reassign-terminal",
            "description": "Grounds must be at least 8 characters. A 2-character reference is 400 `REFERENCE_REQUIRED`. The reservation is unchanged."
          }
        },
        {
          "name": "42 POST reassign terminal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('reassign applied or waiting', function () {",
                  "  pm.expect([200, 202, 400]).to.include(pm.response.code);",
                  "  const body = pm.response.json();",
                  "  if (pm.response.code === 400) {",
                  "    pm.expect(['TERMINAL_DOES_NOT_RACK', 'VALIDATION', 'NOT_FOUND']).to.include(body.code);",
                  "    return;",
                  "  }",
                  "  pm.collectionVariables.set('versionNo', String(body.versionNo));",
                  "  if (pm.response.code === 202) pm.expect(body.status).to.eql('PENDING_COUNTERSIGN');",
                  "  if (pm.response.code === 200) pm.expect(body.terminalSource).to.eql('REASSIGNED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toTerminalId\": \"{{toTerminalId}}\",\n  \"reasonCode\": \"RSN_TERMINAL_OUTAGE\",\n  \"grounds\": \"Gantry bays down for pump repair; the departure cannot load at the derived terminal.\",\n  \"reference\": \"TERM-OUT-20261009-02\",\n  \"versionNo\": {{versionNo}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/reservations/{{reservationId}}/reassign-terminal",
            "description": "`derivedTerminalId` stays the engine's choice. 400 `TERMINAL_DOES_NOT_RACK` when the target cannot rack the product. 202 when the caller cannot counter-sign: recorded, terminal unchanged."
          }
        },
        {
          "name": "43 POST countersign",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('countersign or nothing pending', function () {",
                  "  pm.expect([200, 403, 409]).to.include(pm.response.code);",
                  "  if (pm.response.code === 200) {",
                  "    pm.expect(pm.response.json().terminalSource).to.eql('REASSIGNED');",
                  "    pm.collectionVariables.set('versionNo', String(pm.response.json().versionNo));",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"versionNo\": {{versionNo}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/reservations/{{reservationId}}/countersign",
            "description": "Applies a PENDING_COUNTERSIGN reassignment. 409 when the terminal already moved. 403 when the same person who raised the override tries to counter-sign."
          }
        },
        {
          "name": "44 POST extend expiry",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('window extended', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.expiryExtendedCount).to.be.above(0);",
                  "  pm.collectionVariables.set('versionNo', String(body.versionNo));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newExpiresAt\": \"{{reserveDate}}T23:30:00+05:30\",\n  \"reasonCode\": \"EXT_LOADING_DELAYED\",\n  \"grounds\": \"Loading delayed past the original window; the truck is still in the queue.\",\n  \"reference\": \"LOAD-DELAY-01\",\n  \"versionNo\": {{versionNo}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/reservations/{{reservationId}}/extend-expiry",
            "description": "Capped by the policy (`maxExpiryExtensions`, seed 2). Over the cap is 400 `EXTENSION_CAP_REACHED`. The new expiry must be later than the current one."
          }
        },
        {
          "name": "45 POST accept short",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted when short, otherwise not short', function () {",
                  "  pm.expect([200, 409]).to.include(pm.response.code);",
                  "  if (pm.response.code === 409) pm.expect(pm.response.json().code).to.eql('NOT_SHORT');",
                  "  if (pm.response.code === 200) pm.collectionVariables.set('versionNo', String(pm.response.json().versionNo));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reasonCode\": \"SHT_ACCEPTED_PARTIAL\",\n  \"grounds\": \"Customer accepted a partial load against the declared shortfall.\",\n  \"reference\": \"SHORT-OK-01\",\n  \"versionNo\": {{versionNo}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/reservations/{{reservationId}}/accept-short",
            "description": "200 only when `commitmentOutcome` is SHORT. A covered reservation returns 409 `NOT_SHORT`. Accepting a shortfall does not cancel or release it."
          }
        }
      ]
    },
    {
      "name": "5. Dispatch, sweep, consume",
      "item": [
        {
          "name": "50 POST mark dispatched",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('route dispatched', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().routeStatus).to.eql('DISPATCHED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"routeStatus\": \"DISPATCHED\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/trips/{{tripId}}/route-status",
            "description": "Stand-in for M05/M07 until the route table exists. A dispatched trip's reservation is excluded from expiry."
          }
        },
        {
          "name": "51 POST sweep",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('sweep ran', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.skipped).to.be.a('boolean');",
                  "  pm.expect(body.warned).to.be.a('number');",
                  "  pm.expect(body.expired).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Idempotency-Key", "value": "{{$guid}}" }],
            "url": "{{baseUrl}}/api/v1/ops/reservations/sweep",
            "description": "Server clock only. Warns once inside the lead, holds until the terminal closes, and never expires a dispatched trip. One sweep at a time; a second overlapping call returns `skipped: true`."
          }
        },
        {
          "name": "52 POST consume",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('load consumed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('CONSUMED');",
                  "  pm.collectionVariables.set('versionNo', String(body.versionNo));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
