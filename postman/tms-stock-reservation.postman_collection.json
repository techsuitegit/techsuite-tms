    {
      "name": "2. Terminal availability",
      "item": [
        {
          "name": "20 PUT declaration",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('declareKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('declaration created', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.declarationId).to.be.a('string');",
                  "  pm.expect(body.replayed).to.eql(false);",
                  "  pm.expect(body.position.declaredQty).to.eql(240);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{declareKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"terminalId\": \"{{terminalId}}\",\n  \"materialId\": \"{{materialId}}\",\n  \"availabilityDate\": \"{{reserveDate}}\",\n  \"declaredQty\": 240,\n  \"declaredQtyUom\": \"KL\",\n  \"note\": \"Pipeline receipt confirmed; balance is opening stock.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/terminal-stock/declarations",
            "description": "Append-only revision. The server assigns `revisionNo`. Do not send one. `terminalId` and `materialId` accept an id or a code."
          }
        },
        {
          "name": "21 PUT declaration — same Idempotency-Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('replay returns the same declaration', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().replayed).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{declareKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"terminalId\": \"{{terminalId}}\",\n  \"materialId\": \"{{materialId}}\",\n  \"availabilityDate\": \"{{reserveDate}}\",\n  \"declaredQty\": 240,\n  \"declaredQtyUom\": \"KL\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/terminal-stock/declarations",
            "description": "Run after 20. The same key does not create a second revision."
          }
        },
        {
          "name": "22 PUT declaration — material not racked (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('terminal does not rack the material', function () {",
                  "  pm.expect([400, 404]).to.include(pm.response.code);",
                  "  if (pm.response.code === 400) pm.expect(pm.response.json().code).to.eql('MATERIAL_NOT_RACKED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"terminalId\": \"{{terminalId}}\",\n  \"materialId\": \"{{materialNotRacked}}\",\n  \"availabilityDate\": \"{{reserveDate}}\",\n  \"declaredQty\": 10,\n  \"declaredQtyUom\": \"KL\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/terminal-stock/declarations",
            "description": "Set `materialNotRacked` to a real material code the terminal does not rack (seed default `XP` — only Manali racks XP). 404 if that material does not exist. 400 `MATERIAL_NOT_RACKED` when it does and the terminal's product list excludes it."
          }
