            "description": "`terminalRacksProduct` is computed from current master data. `pesoWarning` is a flag, not a block, when the terminal PESO licence lapses before `reserveDate`."
          }
        },
        {
          "name": "35 GET events",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ledger has the reserve event', function () {",
                  "  pm.response.to.have.status(200);",
