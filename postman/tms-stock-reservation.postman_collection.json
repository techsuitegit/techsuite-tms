                  "  pm.expect(pm.response.json().reservations).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reasonCode\": \"REL_TRIP_CANCELLED\",\n  \"grounds\": \"Confirmed trip cancelled before the truck was dispatched.\",\n  \"reference\": \"TRIP-CANCEL-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/trips/{{tripId2}}/reservations/release",
