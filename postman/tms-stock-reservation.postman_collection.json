            "body": {
              "mode": "raw",
              "raw": "{\n  \"loadId\": \"LOAD-M04-001\",\n  \"consumedQty\": {{qualifiedQty}},\n  \"consumedQtyUom\": \"{{reservedQtyUom}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/reservations/{{reservationId}}/consume",
            "description": "M06 call. Moves the quantity from committed to consumed. A loaded quantity that differs from the reserved quantity is stored on the event, not absorbed. 409 `NOT_ACTIVE` if the reservation was already released."
          }
        },
        {
          "name": "53 POST rebuild positions",
          "event": [
