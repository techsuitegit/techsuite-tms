                  "  const body = pm.response.json();",
                  "  pm.expect(body.items).to.be.an('array');",
                  "  pm.expect(body.total).to.be.a('number');",
                  "  pm.expect(body.counts).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/ops/reservations?tripId={{tripId}}&page=1&pageSize=50",
            "description": "Filters: q, status (repeatable), outcome, terminalId, materialId, reserveDate, reserveDateFrom, reserveDateTo, routeId, orderId, divisionId, expiringBefore, tripId, page, pageSize."
          }
        },
        {
          "name": "34 GET reservation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('one reservation', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.eql(pm.collectionVariables.get('reservationId'));",
                  "  pm.expect(body.terminalRacksProduct).to.be.a('boolean');",
