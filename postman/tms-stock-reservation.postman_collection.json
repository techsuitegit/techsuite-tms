    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "token", "value": "" },
    { "key": "login", "value": "your.email@company.com" },
    { "key": "password", "value": "" },
    { "key": "producttype", "value": "TMS" },
    { "key": "enviroment", "value": "DEV" },
    { "key": "orderId", "value": "" },
    { "key": "tripId", "value": "TRIP-M04-001" },
    { "key": "routeId", "value": "ROUTE-M04-001" },
    { "key": "planId", "value": "PLAN-M04-001" },
    { "key": "tripId2", "value": "TRIP-M04-002" },
    { "key": "routeId2", "value": "ROUTE-M04-002" },
    { "key": "terminalId", "value": "" },
    { "key": "toTerminalId", "value": "" },
    { "key": "materialId", "value": "" },
    { "key": "materialNotRacked", "value": "XP" },
    { "key": "reservationId", "value": "" },
    { "key": "versionNo", "value": "1" },
    { "key": "qualifiedQty", "value": "" },
    { "key": "reservedQtyUom", "value": "L" },
    { "key": "reserveDate", "value": "2026-10-09" },
    { "key": "declareKey", "value": "" }
  ],
  "item": [
    {
      "name": "0. Login",
      "item": [
        {
