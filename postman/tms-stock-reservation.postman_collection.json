                  "  pm.expect(body.reasonCode).to.eql('REL_STOP_UNASSIGNED');",
                  "  pm.collectionVariables.set('versionNo', String(body.versionNo));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
