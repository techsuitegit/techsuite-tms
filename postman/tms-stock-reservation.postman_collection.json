              "raw": "{\n  \"routeId\": \"{{routeId2}}\",\n  \"routeStatus\": \"CONFIRMED\",\n  \"planId\": \"{{planId}}\",\n  \"planKind\": \"LIVE\",\n  \"tripNo\": 1,\n  \"plannedDeparture\": \"{{reserveDate}}T06:00:00+05:30\",\n  \"reserveDate\": \"{{reserveDate}}\",\n  \"orders\": [{ \"orderId\": \"{{orderId}}\", \"shipToLatitude\": 13.05, \"shipToLongitude\": 80.25 }]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/trips/{{tripId2}}/reservations",
