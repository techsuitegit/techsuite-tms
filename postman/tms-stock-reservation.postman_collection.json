                  "  pm.expect(events.length).to.be.above(0);",
                  "  pm.expect(events.some(function (row) { return row.eventType === 'RESERVED'; })).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
