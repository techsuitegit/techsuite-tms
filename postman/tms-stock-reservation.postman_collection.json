              "mode": "raw",
              "raw": "{\n  \"reasonCode\": \"REL_STOP_UNASSIGNED\",\n  \"grounds\": \"Stop removed from the confirmed trip before loading.\",\n  \"reference\": \"STOP-REMOVE-01\",\n  \"versionNo\": {{versionNo}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/reservations/{{reservationId}}/release",
            "description": "Reason code must apply to RELEASE: REL_TRIP_CANCELLED, REL_ORDER_UNQUALIFIED, REL_STOP_UNASSIGNED, REL_PLAN_DISCARDED. There is no cancel and no DELETE."
          }
        },
        {
          "name": "62 POST release again (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('already released', function () {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().code).to.eql('ALREADY_RELEASED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reasonCode\": \"REL_STOP_UNASSIGNED\",\n  \"grounds\": \"Stop removed from the confirmed trip before loading.\",\n  \"reference\": \"STOP-REMOVE-01\",\n  \"versionNo\": {{versionNo}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/ops/reservations/{{reservationId}}/release",
            "description": "Releasing an already-released reservation is 409, not a silent success. Idempotency is the Idempotency-Key, not the status."
          }
        },
        {
          "name": "63 POST release whole trip",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('trip release', function () {",
